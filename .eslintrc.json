{
	"root": true,
	"extends": [
		"wikimedia/client",
		"wikimedia/jquery"
	],
	"globals": {
		"jQuery": "readonly",
		"$": "off"
	},
	"rules": {
		"prefer-const": "off",
		"prefer-arrow-callback": "off",
		"unicorn/prefer-includes": "off",
		"no-jquery/no-extend": "off",
		"no-jquery/no-done-fail": "off"
	}
}
