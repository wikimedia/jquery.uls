{
	"root": true,
	"extends": [
		"wikimedia/client",
		"wikimedia/jquery"
	],
	"rules": {
		"no-jquery/no-global-selector": "off",
		"prefer-arrow-callback": "off",
		"unicorn/prefer-includes": "off"
	},
	"plugins": [
		"html"
	],
	"settings": {
		"html/indent": "+tab",
		"html/report-bad-indent": "error"
	}
}
